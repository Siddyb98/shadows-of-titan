# Copy this file to `.env` and fill in your Supabase project credentials.
# Never commit your real `.env` file or real keys - `.env` is already gitignored.

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public API key (Project Settings -> API -> anon public)
# This key is safe to expose in client-side code; access is enforced by
# Row Level Security policies on the database (see supabase/migrations/).
VITE_SUPABASE_ANON_KEY=your-anon-key
